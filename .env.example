# SVWS-EduGate – Beispiel-Umgebungsdatei für die lokale Entwicklung.
# Kopieren nach .env und Werte setzen: cp .env.example .env
# .env wird niemals committet (.gitignore) und enthält ausschließlich lokale Dev-Secrets.

# --- PostgreSQL (Superuser des Containers; wird NUR von Flyway zur Migration
# verwendet, nie von der Anwendung zur Laufzeit - siehe V1__initial_schema.sql) ---
POSTGRES_USER=edugate_admin
POSTGRES_PASSWORD=change-me-postgres-admin
POSTGRES_DB=edugate

# --- Anwendungsrollen in PostgreSQL (ADR-002/ADR-009) -----------------------
EDUGATE_CONTROL_DB_PASSWORD=change-me-control
EDUGATE_OPERATOR_DB_PASSWORD=change-me-operator
EDUGATE_GATEWAY_DB_PASSWORD=change-me-gateway-ro

# --- Secret-Handling für SVWS-Zugangsdaten (ADR-006) ------------------------
# AES-256-Schlüssel, Base64-kodiert (32 Byte). Erzeugen mit:
#   openssl rand -base64 32
# Niemals mit echtem Wert committen; bei Verlust sind alle verschlüsselten
# SVWS-Zugangsdaten unbrauchbar (siehe ADR-006, Key-Rotation-Hinweis).
EDUGATE_MASTER_KEY=change-me-base64-32-bytes

# --- Keycloak (ADR-005) ------------------------------------------------------
# Admin-Konsole von Keycloak selbst (http://localhost:8180), NICHT der EduGate-Dev-Admin.
KEYCLOAK_ADMIN_USER=keycloak-admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin

# Passwort des Dev-Benutzers admin@edugate.local (Rolle dienstleister-admin),
# wird beim Realm-Import über eine Platzhalter-Substitution gesetzt
# (docker/keycloak/realm-edugate.json), steht also nicht im Realm-JSON.
EDUGATE_DEV_ADMIN_PASSWORD=change-me-dev-admin

# Client-Secret des Demo-Clients (Client-Credentials-Flow) für den
# Gateway-/ping-Testendpunkt.
EDUGATE_DEMO_CLIENT_SECRET=change-me-demo-client-secret
