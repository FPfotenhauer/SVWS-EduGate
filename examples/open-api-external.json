{
  "openapi" : "3.0.1",
  "info" : {
    "title" : "SVWS Open-API Extern",
    "description" : "Die Open-API-Schnittstellenbeschreibungen für extern bereitgestellte API Endpunkte des SVWS-Servers.",
    "license" : {
      "name" : "Apache 2.0",
      "url" : "https://www.apache.org/licenses/LICENSE-2.0.html"
    },
    "version" : "1.5.0-SNAPSHOT"
  },
  "security" : [ {
    "basicAuth" : [ ]
  } ],
  "paths" : {
    "/api/external/{schema}/v1/lernplattformen" : {
      "get" : {
        "tags" : [ "External" ],
        "summary" : "Gibt eine Übersicht aller schulspezifischen Lernplattformen zurück.",
        "description" : "Erstellt eine Liste aller vorhandenen Lernplattformen, insofer die notwendige Berechtigung vorliegen.",
        "operationId" : "getLernplattformen",
        "parameters" : [ {
          "name" : "schema",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "nullable" : true
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "Eine Liste von Lernplattformen",
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/LernplattformV1"
                  }
                }
              }
            }
          },
          "403" : {
            "description" : "Der SVWS-Benutzer hat keine Rechte, um Lernplattformen anzusehen."
          },
          "404" : {
            "description" : "Keine Lernplattformen gefunden"
          }
        }
      }
    },
    "/api/external/{schema}/v1/lernplattformen/{idLernplattform}/{idSchuljahresabschnitt}" : {
      "get" : {
        "tags" : [ "External" ],
        "summary" : "Liefert einen Datenexport aller relevanten Informationen zum angefragten Schuljahresabschnitt für die angegebene Lernplattform.",
        "description" : "Es werden alle relevanten Daten zu Jahrgängen, Klassen, Lehrern, Schülern, Fächern und Lerngruppen aus der SVWS-DB geladen und für den Export bezogen auf eine Lernplattform aufbereitet und zurückgegeben.",
        "operationId" : "getLernplattformenExport",
        "parameters" : [ {
          "name" : "schema",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "nullable" : true
          }
        }, {
          "name" : "idLernplattform",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        }, {
          "name" : "idSchuljahresabschnitt",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int32"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "Die Daten für den Lernplattformen Datenexport",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/LernplattformV1Export"
                }
              }
            }
          },
          "403" : {
            "description" : "Der SVWS-Benutzer hat keine Rechte, um einen Lernplattformen Datenexport anzufordern."
          },
          "404" : {
            "description" : "Es wurden nicht alle benötigten Ressourcen gefunden."
          }
        }
      }
    },
    "/api/external/{schema}/v1/lernplattformen/{idLernplattform}/{idSchuljahresabschnitt}/gzip" : {
      "get" : {
        "tags" : [ "External" ],
        "summary" : "Liefert einen im gzip-Format komprimierten Datenexport aller relevanten Informationen zum angefragten Schuljahresabschnitt für die angegebene Lernplattform.",
        "description" : "Es werden alle relevanten Daten zu Jahrgängen, Klassen, Lehrern, Schülern, Fächern und Lerngruppen aus der SVWS-DB geladen und für den Export bezogen auf eine Lernplattform aufbereitet und komprimiert im gzip-Format zurückgegeben.",
        "operationId" : "getLernplattformenExportAsGzip",
        "parameters" : [ {
          "name" : "schema",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "nullable" : true
          }
        }, {
          "name" : "idLernplattform",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        }, {
          "name" : "idSchuljahresabschnitt",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int32"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "Die Daten für den Lernplattformen Datenexport",
            "content" : {
              "application/octet-stream" : {
                "schema" : {
                  "type" : "string",
                  "format" : "binary"
                }
              }
            }
          },
          "403" : {
            "description" : "Der SVWS-Benutzer hat keine Rechte, um einen Lernplattformen Datenexport anzufordern."
          },
          "404" : {
            "description" : "Es wurden nicht alle benötigten Ressourcen gefunden."
          }
        }
      }
    },
    "/api/external/{schema}/v1/schuljahresabschnitte" : {
      "get" : {
        "tags" : [ "External" ],
        "summary" : "Gibt eine Liste aller verfügbaren Schuljahresabschnitte zurück.",
        "description" : "Erstellt eine Liste aller vorhandenen Schuljahresabschnitte, insofern die notwendige Berechtigung vorliegt.",
        "operationId" : "getSchuljahresabschnitte",
        "parameters" : [ {
          "name" : "schema",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "nullable" : true
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "Eine Liste von Schuljahresabschnitten",
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/SchuljahresabschnittV1"
                  }
                }
              }
            }
          },
          "403" : {
            "description" : "Der SVWS-Benutzer hat keine Rechte, um Schuljahresabschnitte anzusehen."
          },
          "500" : {
            "description" : "Unspezifizierter Fehler (z. B. beim Datenbankzugriff)"
          }
        }
      }
    }
  },
