# SVWS-EduGate – Beispiel-Umgebungsdatei für die lokale Entwicklung.
# Kopieren nach .env und Werte setzen: cp .env.example .env
# .env wird niemals committet (.gitignore) und enthält ausschließlich lokale Dev-Secrets.

# --- PostgreSQL (Superuser des Containers; wird NUR von Flyway zur Migration
# verwendet, nie von der Anwendung zur Laufzeit - siehe V1__initial_schema.sql) ---
POSTGRES_USER=edugate_admin
POSTGRES_PASSWORD=change-me-postgres-admin
POSTGRES_DB=edugate

# --- Anwendungsrollen in PostgreSQL (ADR-002/ADR-009) -----------------------
EDUGATE_CONTROL_DB_PASSWORD=change-me-control
EDUGATE_OPERATOR_DB_PASSWORD=change-me-operator
EDUGATE_GATEWAY_DB_PASSWORD=change-me-gateway-ro

# --- Secret-Handling für SVWS-Zugangsdaten (ADR-006) ------------------------
# AES-256-Schlüssel, Base64-kodiert (32 Byte). Erzeugen mit:
#   openssl rand -base64 32
# Niemals mit echtem Wert committen; bei Verlust sind alle verschlüsselten
# SVWS-Zugangsdaten unbrauchbar (siehe ADR-006, Key-Rotation-Hinweis).
EDUGATE_MASTER_KEY=change-me-base64-32-bytes

# --- Keycloak (ADR-005) ------------------------------------------------------
# Admin-Konsole von Keycloak selbst (http://localhost:8180), NICHT der EduGate-Dev-Admin.
KEYCLOAK_ADMIN_USER=keycloak-admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin

# Passwort des Dev-Benutzers admin@edugate.local (Rolle dienstleister-admin),
# wird beim Realm-Import über eine Platzhalter-Substitution gesetzt
# (docker/keycloak/realm-edugate.json), steht also nicht im Realm-JSON.
EDUGATE_DEV_ADMIN_PASSWORD=change-me-dev-admin

# Client-Secret des Demo-Clients (Client-Credentials-Flow) für den
# Gateway-/ping-Testendpunkt.
EDUGATE_DEMO_CLIENT_SECRET=change-me-demo-client-secret

# --- Dev-Truststore für selbstsignierte Test-SVWS-Instanzen (optional) ------
# Nur lokale Entwicklung (siehe docs/entwicklung/svws-server-api.md,
# DevTrustStoreSslContext). Erweitert additiv die Standard-JVM-Vertrauenskette des
# Connection-Testers - ersetzt sie nicht. In Produktion leer lassen/nicht setzen.
# Pfad ist der Container-interne Mountpunkt aus docker-compose.yml
# (./docker/dev-truststore:/dev-truststore:ro), nicht der Host-Pfad.
# Truststore erzeugen:
#   keytool -importcert -alias <name> -file <zertifikat>.pem \
#     -keystore docker/dev-truststore/svws-dev-truststore.p12 -storetype PKCS12 -storepass <passwort>
#EDUGATE_SVWS_DEV_TRUSTSTORE_PATH=/dev-truststore/svws-dev-truststore.p12
#EDUGATE_SVWS_DEV_TRUSTSTORE_PASSWORD=change-me-truststore-password

# --- Nur für eine echte Produktionsauslieferung relevant (nicht docker-compose.yml) ---------
# docker-compose.yml setzt für control-plane/gateway QUARKUS_PROFILE=dev (lokale
# Entwicklungsumgebung, siehe Kopfkommentar dort); die beiden folgenden Variablen greifen daher
# hier nicht und müssen erst in einer echten %prod-Bereitstellung gesetzt werden.

# Erwarteter OIDC-Issuer (z. B. https://keycloak.example.org/realms/edugate). Ohne diese
# Variable starten Control Plane und Gateway im %prod-Profil nicht (Issue #15) - Fail-Closed
# statt eines stillschweigend deaktivierten Issuer-Checks.
#EDUGATE_OIDC_ISSUER=https://keycloak.example.org/realms/edugate

# Kommaseparierte Liste erlaubter CIDR-Zielnetze für SVWS-Verbindungstests (ADR-007). Ohne
# diese Variable lehnt die Control Plane im %prod-Profil jeden Verbindungstest gegen
# Loopback-/Link-Local-/RFC1918-/Metadata-Adressbereiche ab (SSRF-Schutz, Issue #17) - das
# tatsächliche SVWS-Zielnetz muss hier explizit freigegeben werden.
#EDUGATE_SVWS_ALLOWED_NETWORKS=10.20.0.0/16
